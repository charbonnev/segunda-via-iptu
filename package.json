{
  "name": "segunda-via-iptu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API local para emitir a notificação de lançamento do IPTU de São Paulo",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test test/*.test.js",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.65.0",
    "swagger-ui-dist": "^5.34.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0"
  }
}
